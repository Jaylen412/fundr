{
    "openapi": "3.1.0",
    "info": {
        "title": "FUNDR API",
        "version": "0.1.0"
    },
    "servers": [
        {
            "url": "https://fundr-2rje.onrender.com",
            "description": "small business discovery"
        }
    ],
    "paths": {
        "/discover": {
            "get": {
                "tags": [
                    "discovery"
                ],
                "summary": "Discover",
                "operationId": "discover_discover_get",
                "parameters": [
                    {
                        "name": "city",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "description": "City, e.g., Detroit",
                            "title": "City"
                        },
                        "description": "City, e.g., Detroit"
                    },
                    {
                        "name": "category",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "description": "Category, e.g., coffee shops",
                            "title": "Category"
                        },
                        "description": "Category, e.g., coffee shops"
                    },
                    {
                        "name": "limit",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "maximum": 20,
                            "minimum": 1,
                            "description": "Number of candidates to return",
                            "default": 5,
                            "title": "Limit"
                        },
                        "description": "Number of candidates to return"
                    },
                    {
                        "name": "exclude_chains",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "boolean",
                            "description": "Filter out obvious national chains",
                            "default": true,
                            "title": "Exclude Chains"
                        },
                        "description": "Filter out obvious national chains"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/DiscoverResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/business/{place_id}": {
            "get": {
                "tags": [
                    "business"
                ],
                "summary": "Business Details",
                "operationId": "business_details_business__place_id__get",
                "parameters": [
                    {
                        "name": "place_id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "title": "Place Id"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/FundrItem"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/leaderboard": {
            "get": {
                "tags": [
                    "leaderboard"
                ],
                "summary": "Leaderboard",
                "operationId": "leaderboard_leaderboard_get",
                "parameters": [
                    {
                        "name": "city",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "title": "City"
                        }
                    },
                    {
                        "name": "category",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "title": "Category"
                        }
                    },
                    {
                        "name": "limit",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "default": 10,
                            "title": "Limit"
                        }
                    },
                    {
                        "name": "require_recent",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "boolean",
                            "default": false,
                            "title": "Require Recent"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/LeaderboardResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/score/recompute": {
            "post": {
                "tags": [
                    "scoring"
                ],
                "summary": "Recompute Scores",
                "operationId": "recompute_scores_score_recompute_post",
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "additionalProperties": true,
                                    "type": "object",
                                    "title": "Response Recompute Scores Score Recompute Post"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/health": {
            "get": {
                "tags": [
                    "health"
                ],
                "summary": "Health",
                "description": "Health check endpoint.\n\nReturns HTTP 200 with {\"status\": \"ok\"} if the API is running.\nIf the app is down, this endpoint will not respond with HTTP 200.",
                "operationId": "health_health_get",
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {}
                            }
                        }
                    }
                }
            }
        },
        "/": {
            "get": {
                "tags": [
                    "health"
                ],
                "summary": "Root",
                "operationId": "root__get",
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {}
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "DiscoverResponse": {
                "properties": {
                    "city": {
                        "type": "string",
                        "title": "City"
                    },
                    "category": {
                        "type": "string",
                        "title": "Category"
                    },
                    "count": {
                        "type": "integer",
                        "title": "Count"
                    },
                    "items": {
                        "items": {
                            "$ref": "#/components/schemas/FundrItem"
                        },
                        "type": "array",
                        "title": "Items"
                    }
                },
                "type": "object",
                "required": [
                    "city",
                    "category",
                    "count",
                    "items"
                ],
                "title": "DiscoverResponse"
            },
            "FundrItem": {
                "properties": {
                    "place_id": {
                        "type": "string",
                        "title": "Place Id"
                    },
                    "cid": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Cid"
                    },
                    "name": {
                        "type": "string",
                        "title": "Name"
                    },
                    "types": {
                        "items": {
                            "type": "string"
                        },
                        "type": "array",
                        "title": "Types",
                        "default": []
                    },
                    "address": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Address"
                    },
                    "lat": {
                        "anyOf": [
                            {
                                "type": "number"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Lat"
                    },
                    "lng": {
                        "anyOf": [
                            {
                                "type": "number"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Lng"
                    },
                    "price": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Price"
                    },
                    "open_state": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Open State"
                    },
                    "phone": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Phone"
                    },
                    "website": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Website"
                    },
                    "hours": {
                        "anyOf": [
                            {
                                "additionalProperties": true,
                                "type": "object"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Hours"
                    },
                    "rating": {
                        "anyOf": [
                            {
                                "type": "number"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Rating"
                    },
                    "reviews_count": {
                        "type": "integer",
                        "title": "Reviews Count",
                        "default": 0
                    },
                    "is_chain": {
                        "type": "boolean",
                        "title": "Is Chain",
                        "default": false
                    },
                    "flags": {
                        "items": {
                            "type": "string"
                        },
                        "type": "array",
                        "title": "Flags",
                        "default": []
                    },
                    "fundr_score": {
                        "type": "number",
                        "title": "Fundr Score",
                        "default": 0
                    },
                    "subscores": {
                        "$ref": "#/components/schemas/SubScores"
                    }
                },
                "type": "object",
                "required": [
                    "place_id",
                    "name"
                ],
                "title": "FundrItem"
            },
            "HTTPValidationError": {
                "properties": {
                    "detail": {
                        "items": {
                            "$ref": "#/components/schemas/ValidationError"
                        },
                        "type": "array",
                        "title": "Detail"
                    }
                },
                "type": "object",
                "title": "HTTPValidationError"
            },
            "LeaderboardItem": {
                "properties": {
                    "place_id": {
                        "type": "string",
                        "title": "Place Id"
                    },
                    "name": {
                        "type": "string",
                        "title": "Name"
                    },
                    "fundr_score": {
                        "type": "number",
                        "title": "Fundr Score"
                    },
                    "subscores": {
                        "$ref": "#/components/schemas/SubScores"
                    },
                    "rating": {
                        "anyOf": [
                            {
                                "type": "number"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Rating"
                    },
                    "reviews_count": {
                        "type": "integer",
                        "title": "Reviews Count"
                    },
                    "price": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Price"
                    },
                    "open_state": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Open State"
                    },
                    "badges": {
                        "items": {
                            "type": "string"
                        },
                        "type": "array",
                        "title": "Badges",
                        "default": []
                    },
                    "why_fund": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Why Fund"
                    },
                    "top_praise": {
                        "items": {
                            "type": "string"
                        },
                        "type": "array",
                        "title": "Top Praise",
                        "default": []
                    },
                    "top_fix": {
                        "items": {
                            "type": "string"
                        },
                        "type": "array",
                        "title": "Top Fix",
                        "default": []
                    }
                },
                "type": "object",
                "required": [
                    "place_id",
                    "name",
                    "fundr_score",
                    "subscores",
                    "rating",
                    "reviews_count",
                    "price",
                    "open_state"
                ],
                "title": "LeaderboardItem"
            },
            "LeaderboardResponse": {
                "properties": {
                    "city": {
                        "type": "string",
                        "title": "City"
                    },
                    "category": {
                        "type": "string",
                        "title": "Category"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Updated At"
                    },
                    "items": {
                        "items": {
                            "$ref": "#/components/schemas/LeaderboardItem"
                        },
                        "type": "array",
                        "title": "Items"
                    }
                },
                "type": "object",
                "required": [
                    "city",
                    "category",
                    "updated_at",
                    "items"
                ],
                "title": "LeaderboardResponse"
            },
            "SubScores": {
                "properties": {
                    "quality": {
                        "type": "number",
                        "title": "Quality",
                        "default": 0
                    },
                    "consistency": {
                        "type": "number",
                        "title": "Consistency",
                        "default": 0
                    },
                    "community": {
                        "type": "number",
                        "title": "Community",
                        "default": 0
                    },
                    "ops_fit": {
                        "type": "number",
                        "title": "Ops Fit",
                        "default": 0
                    }
                },
                "type": "object",
                "title": "SubScores"
            },
            "ValidationError": {
                "properties": {
                    "loc": {
                        "items": {
                            "anyOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "integer"
                                }
                            ]
                        },
                        "type": "array",
                        "title": "Location"
                    },
                    "msg": {
                        "type": "string",
                        "title": "Message"
                    },
                    "type": {
                        "type": "string",
                        "title": "Error Type"
                    }
                },
                "type": "object",
                "required": [
                    "loc",
                    "msg",
                    "type"
                ],
                "title": "ValidationError"
            }
        }
    }
}